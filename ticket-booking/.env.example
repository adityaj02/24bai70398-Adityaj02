PORT=3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Lock TTL in milliseconds (how long a seat stays locked while booking)
SEAT_LOCK_TTL_MS=30000

# Booking confirmation TTL in seconds (expire confirmed bookings after N seconds, 0 = no expiry)
BOOKING_TTL_S=0

# Max retry attempts for acquiring a lock
LOCK_RETRY_ATTEMPTS=3
LOCK_RETRY_DELAY_MS=200
